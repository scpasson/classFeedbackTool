<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/header', { title: 'My Question Sets' }) %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css">
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.js"></script>
</head>
<body class="bg-app-body text-app-main min-h-screen p-8">
    <div class="max-w-6xl mx-auto flex flex-col gap-6">
        <header class="flex justify-between items-center border-b border-app-border pb-4">
            <h1 class="text-2xl font-bold text-app-accent">My Question Sets</h1>
            <a href="/dashboard" class="text-sm bg-app-card px-4 py-2 rounded hover:bg-app-sec">Back to Dashboard</a>
        </header>
        <%- include('partials/set-tabs', { active: 'mine' }) %>

        <section id="setBrowser" data-mode="mine" class="bg-app-card p-6 rounded-xl border border-app-border flex flex-col gap-4">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-2 items-center">
                <input id="newTitle" placeholder="New set title" class="bg-app-body border border-app-border p-2 rounded text-sm md:col-span-2">
                <input id="newSubject" placeholder="Subject (e.g. Algebra)" class="bg-app-body border border-app-border p-2 rounded text-sm">
                <button onclick="createSet()" class="bg-app-primary hover:bg-app-primary-hover text-xs px-4 py-2 rounded font-semibold">Create set</button>
            </div>
            <div id="setTable" class="overflow-x-auto"></div>
        </section>
    </div>
    <script src="/scripts/rich-text.js"></script>
    <script src="/scripts/sortable.js"></script>
    <script src="/scripts/set-browser.js"></script>
</body>
</html>
